# Copy to .env and fill in. Never commit .env.
AGENCY_NAME="Mon Agence Location"
BASE_URL=https://check.mon-agence.tn
CARCHECK_VAULT=/opt/carcheck/vault

STAFF_USER=staff
STAFF_PASSWORD=change-me-long-password

# AI (Anthropic API). Without a key, AI_MODE=mock: no automatic marks, staff adds them by hand.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
MIN_CONFIDENCE=0.4

# Walk-around rules
MIN_SECONDS=45
MAX_SECONDS=240
RETENTION_DAYS=60

# WhatsApp Cloud API (Meta for Developers)
WA_TOKEN=
WA_PHONE_ID=
WA_TEMPLATE=car_return_report
WA_LANG=fr
WA_VERIFY_TOKEN=pick-any-random-string
OWNER_PHONE=21698000000

# Rappel avant le retour prévu
WA_REMINDER_TEMPLATE=rappel_retour
REMINDER_HOURS=12
LATE_GRACE_MIN=60
# Kilométrage et carburant : mettez VOS prix
CURRENCY=DT
KM_BILLING=0            # 0 = km notés seulement (pas de frais), 1 = facturer le dépassement
FUEL_BILLING=1          # 1 = facturer le carburant manquant, 0 = le noter seulement
KM_PER_DAY=250          # si KM_BILLING=1 : km inclus par jour (0 = illimité)
EXTRA_KM_PRICE=0.2      # prix par km en plus
TANK_LITERS=45          # taille moyenne des réservoirs
FUEL_PRICE=2.5          # prix du litre
FUEL_FEE=10             # frais de service si carburant manquant

# Planning et réservations en ligne (page client : https://votre-domaine/reserver)
BOOKING_AUTO_CONFIRM=0  # 0 = l'agence confirme chaque demande, 1 = réservation confirmée tout de suite
BOOKING_MAX_DAYS=60
BOOKING_BUFFER_HOURS=2  # temps de préparation (lavage, contrôle) entre deux locations
BOOKING_DOCS_REQUIRED=1  # CIN (recto/verso) ou passeport + permis obligatoires pour réserver en ligne
DOCS_RETENTION_DAYS=30   # suppression au plus tard N jours après la fin prévue
WA_TPL_NEW_BOOKING=nouvelle_reservation
WA_TPL_BOOKING_OK=reservation_confirmee

# Pendant la location
LATE_GRACE_MIN=60       # retard toléré avant l'alerte (agence + client)
MAX_EXTENSION_DAYS=30
WA_TPL_LATE_CLIENT=retard_client
WA_TPL_LATE_OWNER=retard_agence
WA_TPL_MAINTENANCE=entretien

# Entretien
OIL_EVERY_KM=10000
OIL_WARN_KM=500
DOC_WARN_DAYS=30        # alerte assurance / visite technique / vignette N jours avant
MAINTENANCE_DIGEST_HOUR=8

# Facture : à faire vérifier par votre comptable
AGENCY_ADDRESS="Avenue ..., Tunis"
AGENCY_PHONE=71000000
AGENCY_TAX_ID=          # matricule fiscal
VAT_RATE=0              # ex. 19 si vos prix sont TTC avec TVA détaillée
FISCAL_STAMP=0          # timbre fiscal, si applicable
INVOICE_PREFIX=F

# Mettez le fuseau du serveur à celui de l'agence : sudo timedatectl set-timezone Africa/Tunis
